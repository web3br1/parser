# Copy this file to .env before running Docker Compose.
# Do not commit real secrets.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
WORKSPACE_STORAGE_BUCKET=context-builder-private

# Local Docker services
REDIS_URL=redis://redis:6379/0
API_BASE_URL=http://localhost:8000
CELERY_TASK_ALWAYS_EAGER=0

# Real Supabase contract checks / optional SQL access
PSQL_BIN=
SUPABASE_DB_URL=
SUPABASE_POOLER_DB_URL=
# Docker exec fallback for local Supabase (no psql on host PATH).
# Set to the Postgres container name shown by: supabase status
# Example: supabase_db_Parser  (project folder name is used as suffix)
SUPABASE_DB_CONTAINER=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# App
APP_ENV=development
LOG_LEVEL=INFO
TRUSTED_HOSTS=["*"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Models
# Keep local/free by default. Ollama runs on the Windows host; containers reach it via host.docker.internal.
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_TIMEOUT_SECONDS=300
CLASSIFICATION_MODEL=gemma4:31b
EXTRACTION_MODEL=hf.co/hesamation/Qwen3.6-35B-A3B-Claude-4.6-Opus-Reasoning-Distilled-GGUF:Q4_K_M
EXTRACTION_MODEL_FALLBACK=kwangsuklee/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-GGUF:latest
QUERY_MODEL=gemma4:31b
CLASSIFICATION_WORKER_CONCURRENCY=4
CLASSIFICATION_TASK_SOFT_TIME_LIMIT_SECONDS=30
CLASSIFICATION_TASK_TIME_LIMIT_SECONDS=45
EXTRACTION_WORKER_CONCURRENCY=2
EXTRACTION_TASK_SOFT_TIME_LIMIT_SECONDS=60
EXTRACTION_TASK_TIME_LIMIT_SECONDS=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Smoke / pilot users
SMOKE_USER_EMAIL=owner@example.test
SMOKE_USER_PASSWORD=
SMOKE_OUTSIDER_EMAIL=outsider@example.test
SMOKE_OUTSIDER_PASSWORD=
