# Supabase
# Use real values only in .env. Do not commit secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage
WORKSPACE_STORAGE_BUCKET=context-builder-private

# Local services
# REDIS_URL must point to a Redis reachable from this machine.
# Examples: local Redis, WSL Redis, Memurai, Redis Cloud, Upstash.
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://localhost:8000

# Real Supabase contract checks
# Set PSQL_BIN when psql is installed but not available on PATH.
PSQL_BIN=
SUPABASE_DB_URL=
SUPABASE_POOLER_DB_URL=
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# App
APP_ENV=development
LOG_LEVEL=INFO

# Models
MODEL_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=300
CLASSIFICATION_MODEL=gemma4:31b
EXTRACTION_MODEL=hf.co/hesamation/Qwen3.6-35B-A3B-Claude-4.6-Opus-Reasoning-Distilled-GGUF:Q4_K_M
EXTRACTION_MODEL_FALLBACK=kwangsuklee/Qwen3.5-27B-Claude-4.6-Opus-Reasoning-Distilled-GGUF:latest
QUERY_MODEL=gemma4:31b
CLASSIFICATION_WORKER_CONCURRENCY=4
CLASSIFICATION_TASK_SOFT_TIME_LIMIT_SECONDS=30
CLASSIFICATION_TASK_TIME_LIMIT_SECONDS=45
EXTRACTION_WORKER_CONCURRENCY=2
EXTRACTION_TASK_SOFT_TIME_LIMIT_SECONDS=60
EXTRACTION_TASK_TIME_LIMIT_SECONDS=90
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Smoke users
SMOKE_USER_EMAIL=owner@example.test
SMOKE_USER_PASSWORD=
SMOKE_OUTSIDER_EMAIL=outsider@example.test
SMOKE_OUTSIDER_PASSWORD=
